<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_user"
        android:textColor="@color/pink_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/user_name"
        android:textColorHint="@color/text_muted"
        app:boxStrokeColor="@color/pink_primary"
        app:hintTextColor="@color/pink_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_dialog_user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:textColor="@color/text_white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/user_email"
        android:textColorHint="@color/text_muted"
        app:boxStrokeColor="@color/pink_primary"
        app:hintTextColor="@color/pink_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_dialog_user_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="@color/text_white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/user_phone"
        android:textColorHint="@color/text_muted"
        app:boxStrokeColor="@color/pink_primary"
        app:hintTextColor="@color/pink_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_dialog_user_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:textColor="@color/text_white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/user_role"
        android:textColorHint="@color/text_muted"
        app:boxStrokeColor="@color/pink_primary"
        app:hintTextColor="@color/pink_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_dialog_user_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/text_white" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
