<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="140dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="44dp">

            <!-- Top Header Bar: Left ("¡Hola!" + Moon | "Buenas Noches SmartTemp") | Right Logo -->
            <RelativeLayout
                android:id="@+id/layout_top_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Left Section: Greeting + Moon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/iv_main_logo"
                    android:orientation="vertical">

                    <!-- Top Line: ¡Hola! + Moon Icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_greeting_hello"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hello_prefix"
                            android:textColor="@color/text_dark"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <!-- Moon Icon 🌕 right beside ¡Hola! -->
                        <ImageView
                            android:id="@+id/iv_weather_icon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="@string/app_name"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_moon" />

                    </LinearLayout>

                    <!-- Bottom Line: Buenas Noches SmartTemp in Sweet Pastel Pink -->
                    <TextView
                        android:id="@+id/tv_greeting_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/greeting_night"
                        android:textColor="@color/pink_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Right Section: App Logo Image -->
                <ImageView
                    android:id="@+id/iv_main_logo"
                    android:layout_width="80dp"
                    android:layout_height="60dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitEnd"
                    android:src="@drawable/imagenapp" />

            </RelativeLayout>

            <!-- Hero Dashboard Card (Pink Space from Sensors) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hero_pink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_top_header">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pink_hero_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/iot_system_status"
                        android:textColor="@color/text_pink_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Monitoreo Térmico en Tiempo Real"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Live Date & Time Display -->
                    <TextView
                        android:id="@+id/tv_pink_hero_time_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hora Actual: Cargando..."
                        android:textColor="@color/text_pink_light"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Avg Temp -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Temperatura Promedio"
                                android:textColor="@color/text_pink_light"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_pink_hero_temp_main"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-- °C"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Avg Humidity -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Humedad Relativa"
                                android:textColor="@color/text_pink_light"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_pink_hero_hum_main"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-- %"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Hero Pill Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_hero_sensors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="16dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/btn_see_sensors"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="21dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carousel Section: Sensores por Localidad -->
            <LinearLayout
                android:id="@+id/layout_carousel_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_hero_pink">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/sensors_by_location"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_sensors_carousel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_carousel_sensor" />

            </LinearLayout>

            <!-- FUNCIONALIDADES SECTION -->
            <LinearLayout
                android:id="@+id/layout_features_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_carousel_section">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Funcionalidades"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Feature 1 Card: Encender Flash -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_flashlight"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1.2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:id="@+id/iv_icon_flashlight"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_flashlight"
                            app:tint="@color/pink_primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toStartOf="@+id/switch_flashlight"
                            android:layout_toEndOf="@+id/iv_icon_flashlight"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Encender Flash"
                                android:textColor="@color/text_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_flash_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Apagada"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Switch Control -->
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_flashlight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:useMaterialThemeColors="true" />

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section: Mis Ampolletas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:text="Mis Ampolletas"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Horizontal RecyclerView for Ampolletas -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_ampolletas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_ampolleta" />

                <!-- SECCIÓN: DESARROLLADORES PNK -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Desarrolladores Pnk"
                        android:textColor="@color/text_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="Personas detrás de SmartTemp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Vertical List RecyclerView for Team Devs -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_team_devs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_team_dev" />

                </LinearLayout>

                <!-- Bottom Clearance Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Bottom Floating Curved Navigation Bar Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="26dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Nav Item 1: Home -->
            <TextView
                android:id="@+id/nav_item_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingTop="4dp"
                android:text="@string/nav_home"
                android:textColor="@color/pink_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:drawableTint="@color/pink_primary"
                app:drawableTopCompat="@drawable/ic_home" />

            <!-- Nav Item 2: Usuarios -->
            <TextView
                android:id="@+id/nav_item_users"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingTop="4dp"
                android:text="@string/nav_users"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:drawableTint="@color/text_secondary"
                app:drawableTopCompat="@drawable/ic_users" />

            <!-- Center Floating Action Plus FAB Button (+) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_add_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/add_new_action"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/pink_primary"
                app:elevation="3dp"
                app:fabCustomSize="48dp"
                app:tint="@color/white" />

            <!-- Nav Item 3: Sensores -->
            <TextView
                android:id="@+id/nav_item_sensors"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingTop="4dp"
                android:text="@string/nav_sensors"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:drawableTint="@color/text_secondary"
                app:drawableTopCompat="@drawable/ic_sensors" />

            <!-- Nav Item 4: Ajustes -->
            <TextView
                android:id="@+id/nav_item_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingTop="4dp"
                android:text="@string/nav_devs"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:drawableTint="@color/text_secondary"
                app:drawableTopCompat="@drawable/ic_settings" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
