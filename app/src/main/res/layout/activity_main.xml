<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="140dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingTop="44dp">

            <!-- Top Header Bar: Left ("¡Hola!" + Moon | "Buenas Noches SmartTemp") | Right Logo -->
            <RelativeLayout
                android:id="@+id/layout_top_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Left Section: Greeting + Moon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/iv_main_logo"
                    android:orientation="vertical">

                    <!-- Top Line: ¡Hola! + Moon Icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_greeting_hello"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hello_prefix"
                            android:textColor="@color/text_dark"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <!-- Moon Icon 🌕 right beside ¡Hola! -->
                        <ImageView
                            android:id="@+id/iv_weather_icon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="@string/app_name"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_moon" />

                    </LinearLayout>

                    <!-- Bottom Line: Buenas Noches SmartTemp in Sweet Pastel Pink -->
                    <TextView
                        android:id="@+id/tv_greeting_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/greeting_night"
                        android:textColor="@color/pink_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Right Section: App Logo Image -->
                <ImageView
                    android:id="@+id/iv_main_logo"
                    android:layout_width="80dp"
                    android:layout_height="60dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitEnd"
                    android:src="@drawable/imagenapp" />

            </RelativeLayout>

            <!-- Hero Dashboard Card (Pink Space from Sensors) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hero_pink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_top_header">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pink_hero_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/iot_system_status"
                        android:textColor="@color/text_pink_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Monitoreo Térmico en Tiempo Real"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Live Date & Time Display -->
                    <TextView
                        android:id="@+id/tv_pink_hero_time_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hora Actual: Cargando..."
                        android:textColor="@color/text_pink_light"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Avg Temp -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Temperatura Promedio"
                                android:textColor="@color/text_pink_light"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_pink_hero_temp_main"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-- °C"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Avg Humidity -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Humedad Relativa"
                                android:textColor="@color/text_pink_light"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_pink_hero_hum_main"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-- %"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Hero Pill Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_hero_sensors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="16dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/btn_see_sensors"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="21dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carousel Section: Sensores por Localidad -->
            <LinearLayout
                android:id="@+id/layout_carousel_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_hero_pink">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/sensors_by_location"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_sensors_carousel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_carousel_sensor" />

            </LinearLayout>

            <!-- Middle Section: Active Dashboard Section (Active User & Active Sensor Cards) -->
            <LinearLayout
                android:id="@+id/layout_active_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_carousel_section">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/active_monitoring"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Card 1: Usuario Activo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_active_user"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:id="@+id/iv_icon_active_user"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_users"
                            app:tint="@color/pink_primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toStartOf="@+id/status_dot_1"
                            android:layout_toEndOf="@+id/iv_icon_active_user"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/active_user_label"
                                android:textColor="@color/text_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_active_user_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/active_user_name"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Green Online Status Indicator Dot -->
                        <View
                            android:id="@+id/status_dot_1"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_status_active" />

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Sensor Activo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_active_sensor"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:id="@+id/iv_icon_active_sensor"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_sensors"
                            app:tint="@color/pink_primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toStartOf="@+id/status_dot_2"
                            android:layout_toEndOf="@+id/iv_icon_active_sensor"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/active_sensor_label"
                                android:textColor="@color/text_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_active_sensor_info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/active_sensor_info"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Green Online Status Indicator Dot -->
                        <View
                            android:id="@+id/status_dot_2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_status_active" />

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 3: DESARROLLADOR -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_btn_desarrollador"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="18dp">

                        <ImageView
                            android:id="@+id/iv_icon_dev"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/btn_desarrollador"
                            android:src="@drawable/ic_developers"
                            app:tint="@color/pink_primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toStartOf="@+id/badge_arrow_3"
                            android:layout_toEndOf="@+id/iv_icon_dev"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_desarrollador"
                                android:textColor="@color/text_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/dev_team_names"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Right Arrow Circle Badge -->
                        <TextView
                            android:id="@+id/badge_arrow_3"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_pink_tag"
                            android:gravity="center"
                            android:text="@string/arrow_right_symbol"
                            android:textColor="@color/pink_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bottom Clearance Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Bottom Floating Curved Navigation Bar Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="26dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Nav Item 1: Home -->
            <TextView
                android:id="@+id/nav_item_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingTop="4dp"
                android:text="@string/nav_home"
                android:textColor="@color/pink_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:drawableTint="@color/pink_primary"
                app:drawableTopCompat="@drawable/ic_users" />

            <!-- Nav Item 2: Usuarios -->
            <TextView
                android:id="@+id/nav_item_users"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingTop="4dp"
                android:text="@string/nav_users"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:drawableTint="@color/text_secondary"
                app:drawableTopCompat="@drawable/ic_users" />

            <!-- Center Floating Action Plus FAB Button (+) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_add_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/add_new_action"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/pink_primary"
                app:elevation="3dp"
                app:fabCustomSize="48dp"
                app:tint="@color/white" />

            <!-- Nav Item 3: Sensores -->
            <TextView
                android:id="@+id/nav_item_sensors"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingTop="4dp"
                android:text="@string/nav_sensors"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:drawableTint="@color/text_secondary"
                app:drawableTopCompat="@drawable/ic_sensors" />

            <!-- Nav Item 4: Ajustes -->
            <TextView
                android:id="@+id/nav_item_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingTop="4dp"
                android:text="@string/nav_devs"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:drawableTint="@color/text_secondary"
                app:drawableTopCompat="@drawable/ic_settings" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
