<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dev_profile_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="40dp"
    tools:context=".DeveloperProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dev_profile_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="22dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/layout_dev_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_dev_profile_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_pink_tag"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/pink_primary" />

            <TextView
                android:id="@+id/tv_dev_profile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Perfil Desarrollador"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_dev_profile_logo"
                android:layout_width="65dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitEnd"
                android:src="@drawable/imagenapp" />

        </RelativeLayout>

        <!-- Profile Photo & Name Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_dev_photo_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_dev_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Circular Avatar Picture -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_dev_avatar_large"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    app:cardBackgroundColor="@color/pink_pastel_light"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/pink_primary"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/iv_dev_profile_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_users"
                        app:tint="@color/pink_primary" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_dev_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Nombre Desarrollador"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dev_profile_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Rol en SmartTemp"
                    android:textColor="@color/pink_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Button Cambiar Foto (Oculto - Solo lectura) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dev_change_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingHorizontal="20dp"
                    android:text="Cambiar Foto de Perfil"
                    android:textColor="@color/pink_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/pink_pastel_light"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/pink_primary"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Developer Info Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_dev_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_dev_photo_section">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información del Proyecto"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dev_profile_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/card_border" />

                <TextView
                    android:id="@+id/tv_dev_profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pink_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dev_profile_github"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Save/Done Button (Oculto - Solo lectura) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dev_profile_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Guardar Cambios"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/pink_primary"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_dev_details" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
