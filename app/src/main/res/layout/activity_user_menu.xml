<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/user_menu_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".UserMenuActivity">

    <LinearLayout
        android:id="@+id/user_menu_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="40dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/iv_user_menu_logo"
            android:layout_width="220dp"
            android:layout_height="140dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/imagenapp" />

        <!-- GESTIÓN DE USUARIOS -->
        <TextView
            android:id="@+id/tv_user_menu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/title_user_mgmt"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Button 1: INGRESAR USUARIOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_ingresar_usuarios"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="@string/btn_ingresar_usuarios"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/red_primary"
            app:cornerRadius="14dp" />

        <!-- Button 2: LISTAR USUARIOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_listar_usuarios"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/btn_listar_usuarios"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/navy_dark"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
