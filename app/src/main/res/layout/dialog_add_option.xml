<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_add_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Row: Close Icon (X Rosada) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Logo Image -->
        <ImageView
            android:layout_width="65dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/imagenapp" />

        <!-- Pink X Close Button -->
        <ImageButton
            android:id="@+id/btn_dialog_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pink_tag"
            android:contentDescription="@string/app_name"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/pink_primary" />
    </RelativeLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="¿Qué deseas registrar?"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Selecciona el módulo para ingresar nueva información al sistema"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Option 1: Registrar Nuevo Usuario -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_add_user"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:text="REGISTRAR NUEVO USUARIO"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/pink_primary"
        app:cornerRadius="26dp"
        app:icon="@drawable/ic_users"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="@color/white" />

    <!-- Option 2: Registrar Nuevo Sensor IoT -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_add_sensor"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="REGISTRAR NUEVO SENSOR IOT"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/black_button"
        app:cornerRadius="26dp"
        app:icon="@drawable/ic_sensors"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="@color/white" />

</LinearLayout>
