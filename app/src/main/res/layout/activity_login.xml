<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/login_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <!-- 1. INITIAL GET STARTED VIEW (Screen 1) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_initial_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Logo Image -->
            <ImageView
                android:id="@+id/iv_initial_logo"
                android:layout_width="160dp"
                android:layout_height="130dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/imagenapp"
                app:layout_constraintBottom_toTopOf="@+id/tv_initial_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.45" />

            <!-- Title: ¡Hola! ingresa a SmartTemp -->
            <TextView
                android:id="@+id/tv_initial_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="¡Hola! ingresa a SmartTemp"
                android:textColor="@color/pink_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/tv_initial_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_initial_logo" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tv_initial_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Elige una opción para continuar"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@+id/btn_option_register"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_initial_title" />

            <!-- Pill Button 1: REGÍSTRATE AQUÍ (Pink) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_register"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginHorizontal="36dp"
                android:layout_marginTop="28dp"
                android:text="@string/btn_registrarme"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pink_primary"
                app:cornerRadius="27dp"
                app:layout_constraintBottom_toTopOf="@+id/btn_option_login"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_initial_subtitle" />

            <!-- Pill Button 2: INICIAR SESIÓN (Black) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_login"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginHorizontal="36dp"
                android:layout_marginTop="14dp"
                android:text="@string/btn_ingresar"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/black_button"
                app:cornerRadius="27dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_option_register" />

            <!-- Bottom Pink Wave Decoration -->

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. LOGIN FORM VIEW (Screen 3 - Pink Bottom Container) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_login_form"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Top Header Bar -->
            <LinearLayout
                android:id="@+id/header_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Small Top Left Logo -->
                <ImageView
                    android:id="@+id/iv_form_logo"
                    android:layout_width="60dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitStart"
                    android:src="@drawable/imagenapp" />

                <!-- Hello Welcome Back Title -->
                <TextView
                    android:id="@+id/tv_welcome_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="¡Hola!\nBienvenido"
                    android:textColor="@color/pink_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bottom Pastel Pink Rounded Container (Rounded Top Corners 36dp against white header) -->
            <LinearLayout
                android:id="@+id/card_pink_login"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_bottom_pink_card"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="32dp"
                android:paddingBottom="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_login">

                <!-- Field 1: Phone or Gmail / INGRESE USUARIO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/username"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_white_input_box"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/login_user_hint"
                        android:inputType="textEmailAddress"
                        android:textColor="#111827"
                        android:textColorHint="#9CA3AF"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Field 2: Password / INGRESE CLAVE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/password"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_white_input_box"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/iv_password_toggle"
                        android:background="@null"
                        android:hint="@string/login_pass_hint"
                        android:inputType="textPassword"
                        android:textColor="#111827"
                        android:textColorHint="#9CA3AF"
                        android:textSize="15sp" />

                    <!-- Eye Icon for Toggling Password -->
                    <ImageView
                        android:id="@+id/iv_password_toggle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:padding="3dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/pink_primary" />
                </RelativeLayout>

                <!-- Forgot Password? Link -->
                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="@string/btn_forgot_prompt"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Black Pill Button: SIGN IN -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/btn_ingresar"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/black_button"
                    app:cornerRadius="26dp"
                    app:elevation="4dp" />

                <!-- Links: Regístrate aquí & Volver -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_form_register_prompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="6dp"
                        android:text="¿No tienes una cuenta? Regístrate aquí"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_back_to_options"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="6dp"
                        android:text="← Volver a Inicio"
                        android:textColor="@color/text_pink_light"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>